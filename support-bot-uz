from telegram.ext import Application, CommandHandler, MessageHandler, filters

BOT_TOKEN = "TOKENNI_BU_YERGA_QOYING"
ADMIN_ID = 123456789

async def start(update, context):
await update.message.reply_text("Support bot ishlayapti. Xabaringizni yuboring.")

async def forward_to_admin(update, context):
if update.message:
user = update.effective_user
text = update.message.text or ""
await context.bot.send_message(
chat_id=ADMIN_ID,
text=f"📩 Yangi xabar\n\n👤 {user.full_name}\n🆔 {user.id}\n\n{text}"
)

app = Application.builder().token(BOT_TOKEN).build()

app.add_handler(CommandHandler("start", start))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, forward_to_admin))

app.run_polling()